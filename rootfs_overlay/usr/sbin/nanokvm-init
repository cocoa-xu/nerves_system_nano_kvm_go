#!/bin/sh
# Board setup before the Erlang VM starts (erlinit --pre-run-exec):
# - a USB gadget with a network (NCM) and a serial (ACM) function, so the
#   computer the NanoKVM-Go is plugged into reaches it without a UART. An
#   application that wants other functions (HID, mass storage) rebuilds it.
# - the AIC8800 Wi-Fi driver, which has no device table to autoload from.

gadget=/sys/kernel/config/usb_gadget/nanokvm

mountpoint -q /sys/kernel/config || mount -t configfs configfs /sys/kernel/config
if [ ! -d $gadget ]; then
	mkdir -p $gadget/strings/0x409 $gadget/configs/c.1/strings/0x409
	echo 0x1d6b > $gadget/idVendor
	echo 0x0104 > $gadget/idProduct
	echo "Nerves" > $gadget/strings/0x409/manufacturer
	echo "NanoKVM-Go" > $gadget/strings/0x409/product
	cat /sys/block/mmcblk0/device/serial > $gadget/strings/0x409/serialnumber 2>/dev/null
	echo "ncm+acm" > $gadget/configs/c.1/strings/0x409/configuration
	mkdir -p $gadget/functions/ncm.usb0 $gadget/functions/acm.GS0
	ln -s $gadget/functions/ncm.usb0 $gadget/configs/c.1/
	ln -s $gadget/functions/acm.GS0 $gadget/configs/c.1/
	ls /sys/class/udc | head -n 1 > $gadget/UDC
fi

modprobe aic8800_fdrv

exit 0
