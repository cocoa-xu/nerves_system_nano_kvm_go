# U-Boot environment for the NanoKVM-Go
#
# Built into uboot-env.bin (redundant format) and written by fwup at 0x80000
# and 0xa0000 on the SD card. U-Boot runs nerves_bootcmd, or nerves_bootkey
# while the BOOT button is held. Its built-in default environment is the same
# (cocoa-xu/u-boot-ax620e): keep both in sync.
#
# Layout (fwup_include/fwup-common.conf): a FIT image (zImage + DTB with
# sha256 hashes) in a raw slot per side, rootfs A/B on p2/p3. The FIT is
# loaded at fit_addr_r; its kernel is copied to 0x42000000 since the zImage
# has to run in the first 128 MiB of DRAM.

sdupdate=finish

# UART3, the console of U-Boot and of the vendor's Linux, has its pads on the
# auxiliary USB-C port: they are expansion lines for the application. U-Boot
# does not wait for a key there (-2), and Linux gets ttynull as its console
# and the RAM log for its early messages. fwup.conf sets both on upgrades too.
bootdelay=-2

# nerves_fw_autovalidate=0: a new firmware has to be validated by the
# application (nerves_runtime's startup guard does it once every OTP
# application started), otherwise the next reboot goes back to the other slot.
nerves_fw_active=a
nerves_fw_autovalidate=0
nerves_fw_validated=1
nerves_fw_booted=0

kernel_a_blk=0x42000
kernel_b_blk=0x52000
kernel_blks=0x8000
fit_addr_r=0x45000000

# Extra kernel arguments
cmdline=

# U-Boot gives Linux the DRAM the chip has, 512 MiB on the Go+ and 256 MiB
# on the Go, so a card boots on either. The RAM log is the top MiB of the
# first 256 MiB, which both have: U-Boot's console, then the kernel's.
#
# CMA pools in MiB, which U-Boot writes into the device tree at every boot:
# cma_video for video (Linux's default pool) and cma_npu for the NPU (0
# turns the NPU off). Multiples of 8, video at least 8, together leaving
# Linux at least 96 MiB. Unset sizes, or sizes that do not fit the board,
# give the board's: the device tree's 192 and 64 on the Go+, 144 and 0 on the
# Go; a card moved between them keeps its sizes for its own board. A trial of new
# sizes (opt-in) keeps the old ones in cma_video_was and cma_npu_was and sets
# cma_try=1. The next boot makes that 2; validating the firmware
# (fwup-ops.conf) keeps the new sizes, and a boot that still finds 2 puts the
# old ones back. fwup.conf sets nerves_cma and nerves_bootcmd on upgrades.
nerves_cma=if test "$cma_try" = 2; then setenv cma_video $cma_video_was; setenv cma_npu $cma_npu_was; setenv cma_try; setenv cma_video_was; setenv cma_npu_was; saveenv; elif test "$cma_try" = 1; then setenv cma_try 2; saveenv; fi

nerves_revert=if test "${nerves_fw_active}" = a; then setenv nerves_fw_active b; else setenv nerves_fw_active a; fi
nerves_init=if test "${nerves_fw_booted}" = 1; then if test "${nerves_fw_validated}" = 0; then run nerves_revert; setenv nerves_fw_validated 1; saveenv; fi; else setenv nerves_fw_booted 1; if test "${nerves_fw_autovalidate}" = 1; then setenv nerves_fw_validated 1; fi; saveenv; fi
nerves_load=if test "${nerves_fw_active}" = b; then setenv kernel_blk ${kernel_b_blk}; setenv rootfs_part 3; else setenv kernel_blk ${kernel_a_blk}; setenv rootfs_part 2; fi; mmc dev 1 && mmc read ${fit_addr_r} ${kernel_blk} ${kernel_blks}
# $name rather than ${name}: fwup.conf sets nerves_try on upgrades as well,
# and fwup would expand ${name} itself. The arguments in quotes, as one: a
# U-Boot command takes at most CONFIG_SYS_MAXARGS arguments (16 before
# U-Boot 13b9d43d), and more words in cmdline failed this setenv, so the
# boot, which then went to the other slot.
nerves_try=run nerves_load && setenv bootargs "console=ttynull earlycon=ramlog,0x4ff10000 keep_bootcon root=/dev/mmcblk0p$rootfs_part rootfstype=squashfs rootwait ro $cmdline" && axwdt 120 && bootm $fit_addr_r
nerves_bootcmd=run nerves_init; run nerves_cma; run nerves_try; run nerves_revert; setenv nerves_fw_validated 1; saveenv; run nerves_try
nerves_bootkey=run nerves_revert; setenv nerves_fw_validated 1; saveenv; run nerves_try
